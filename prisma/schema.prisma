datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTH.JS (NEXTAUTH V5) & WORKSPACE OWNERSHIP
// ==========================================

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  jobTitle      String?           @default("Growth & Performance Lead")
  currency      String            @default("USD ($)")
  company       String?
  timezone      String?
  phone         String?
  notificationPrefs Json?
  plainLanguage Boolean           @default(true)
  linkGuard     Boolean           @default(true)
  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("OWNER") // OWNER, ADMIN, VIEWER
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ==========================================
// 2. YOUR EXISTING ADORACLE WORKSPACE MODELS
// ==========================================

model Workspace {
  id              String             @id @default(uuid())
  name            String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         WorkspaceMember[]
  integrations    IntegrationToken[]
  businessProfile BusinessProfile?
  campaigns       Campaign[]
  lessons         LearningLesson[]
  seoAudits       SeoAudit[]
  urlAudits       UrlAudit[]
  posts           SocialPost[]
  billingEmail    String?
  taxId           String?
  invites         WorkspaceInvite[]
  consents        ConsentRecord[]
  media           MediaAsset[]
  rules           AutomationRule[]
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("VIEWER")
  status      String    @default("PENDING")
  invitedBy   String?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
}

// What the user agreed to when connecting an account (kept for transparency + compliance)
model ConsentRecord {
  id               String    @id @default(uuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String
  provider         String
  features         String[]
  scopes           String?   @db.Text
  agreementVersion String
  ipAddress        String?
  userAgent        String?   @db.Text
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?
}

model MediaAsset {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String    @db.Text
  pathname    String    @db.Text
  name        String
  contentType String
  size        Int       @default(0)
  kind        String    @default("IMAGE") // IMAGE | VIDEO
  createdAt   DateTime  @default(now())
}

model AutomationRule {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  platform    String    @default("ALL")
  metric      String    // CPA, ROAS, CTR, FREQUENCY, SPEND
  operator    String    // GT, LT
  value       Float
  minSpend    Float     @default(0)
  action      String    // PAUSE, SCALE_UP, SCALE_DOWN, NOTIFY
  actionValue Float?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  lastResult  String?   @db.Text
  createdAt   DateTime  @default(now())
}

model AdSet {
  id           String   @id @default(uuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  status       String   @default("PAUSED") // ACTIVE | PAUSED
  budget       Float?
  budgetType   String   @default("daily")
  startTime    DateTime?
  endTime      DateTime?
  audience     String?  @db.Text
  placements   String?  @db.Text
  bidStrategy  String?
  optimization String?
  externalId   String?
  ads          Ad[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Ad {
  id             String   @id @default(uuid())
  adSetId        String
  adSet          AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  campaignId     String
  name           String
  status         String   @default("PAUSED") // ACTIVE | PAUSED
  format         String?
  primaryText    String   @db.Text
  headline       String
  description    String?
  cta            String   @default("Learn more")
  destinationUrl String   @db.Text
  mediaUrl       String?  @db.Text
  mediaType      String?
  sourcePostId   String?
  sourcePostUrl  String?  @db.Text
  externalId     String?
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  spend          Float    @default(0)
  conversions    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IntegrationToken {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform     Platform
  accountId    String    // Real Ad Account ID (e.g. "act_123456789")
  accountName  String?
  accessToken  String    @db.Text // Encrypted via AES-256
  refreshToken String?   @db.Text // Encrypted via AES-256
  status       String    @default("CONNECTED")
  scopes       String?   @db.Text
  meta         Json?     // e.g. { accounts: [...], pages: [...], pixelId: "..." } (no secrets here)
  expiresAt    DateTime?
  connectedAt  DateTime  @default(now())
  lastSyncedAt DateTime  @default(now())

  @@unique([workspaceId, platform, accountId])
}

model BusinessProfile {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websiteUrl     String
  offerings      String
  priceTier      String    // LOW, MID, HIGH
  targetAudience String
  reachType      String    // LOCAL, NATIONAL, GLOBAL
  scrapedAt      DateTime  @default(now())
}

model Campaign {
  id                 String         @id @default(uuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform           Platform
  externalCampaignId String         // Real ID from Meta / Google / TikTok / LinkedIn
  name               String
  status             CampaignStatus @default(ACTIVE)
  destinationUrl     String?
  dailyBudget        Float          @default(0.0)
  customersWon       Int            @default(0) // Maps to conversions
  costPerCustomer    Float          @default(0.0) // Maps to CPA
  totalSpend         Float          @default(0.0)
  revenue            Float          @default(0.0)
  impressions        Int            @default(0)
  clicks             Int            @default(0)
  roas               Float          @default(0.0)
  aiOptimizing       Boolean        @default(true)
  objective          String?
  launchStatus       String         @default("LIVE") // DRAFT, QUEUED, PUSHED, FAILED, LIVE
  launchMessage      String?        @db.Text
  structure          Json?          // full Campaign > Ad set > Ad blueprint created in the builder
  adSets             AdSet[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([workspaceId, platform, externalCampaignId])
}

model LearningLesson {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    String    // e.g., "Winning Offer-Lead Headlines", "Best Converting Hours"
  description String
  confidence  String    // "High Confidence", "Medium Confidence"
  createdAt   DateTime  @default(now())
}

model SeoAudit {
  id                String    @id @default(uuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  healthScore       Int       // e.g., 88
  organicClicks     Int
  searchImpressions Int
  coreWebVitals     Boolean   // True if 3/3 met
  brokenLinksCount  Int       // Triggers Crimson Red banner if > 0
  url               String?
  details           Json?
  auditedAt         DateTime  @default(now())
}

model UrlAudit {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  statusCode  Int
  isHealthy   Boolean
  redirectUrl String?
  responseMs  Int
  source      String?   // e.g. 'AD:<id>' or 'MANUAL'
  chain       Json?
  checkedAt   DateTime  @default(now())
}

model SocialPost {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  caption     String    @db.Text
  mediaUrl    String?
  link        String?
  platforms   String[]  // META, TIKTOK, YOUTUBE, LINKEDIN
  status      String    @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  scheduledAt DateTime?
  publishedAt DateTime?
  postType    String    @default("POST") // POST | REEL | STORY
  mediaType   String?   // IMAGE | VIDEO
  alsoInstagram Boolean @default(false)
  results     Json?     // per-platform result messages
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Platform {
  META
  TIKTOK
  GOOGLE
  YOUTUBE
  LINKEDIN
}

enum CampaignStatus {
  ACTIVE
  LEARNING
  ERROR
  PAUSED
}