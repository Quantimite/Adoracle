# ---------- Database (Neon / Supabase / Vercel Postgres) ----------
DATABASE_URL="postgresql://postgres:password@localhost:5432/adoracle?schema=public"

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Your deployed URL (no trailing slash). Locally: http://localhost:3000
AUTH_URL="https://adoracle-liard.vercel.app"
NEXTAUTH_URL="https://adoracle-liard.vercel.app"

# ---------- "Continue with Google" (login) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Authorized redirect URI:  https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Token vault (REQUIRED in production) ----------
# Generate with: openssl rand -hex 32   (never commit the real value)
TOKEN_ENCRYPTION_SECRET=""

# ---------- Ad platform connections (Settings > Connections) ----------
# Redirect URI for every platform:  https://YOUR-DOMAIN/api/connect/<platform>/callback
#   platform = meta | google | tiktok | linkedin
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ---------- File uploads (photos / videos / Reels from your device) ----------
# Vercel → Storage → Create Blob store → copy the token
BLOB_READ_WRITE_TOKEN=""

# ---------- Scheduler (automation rules + scheduled posts) ----------
# Any long random string. Vercel sends it automatically to /api/cron/*
CRON_SECRET=""

# ---------- Optional ----------
# Fully AI-written ad copy in AI Intelligence
ANTHROPIC_API_KEY=""
# Higher PageSpeed quota for SEO audits
GOOGLE_PSI_API_KEY=""

# ---------- Site admin ----------
# Comma-separated emails that can see Settings → Platform setup (the one-time developer-app guide).
# If empty, every signed-in user can see it. Set this before inviting other people.
ADMIN_EMAILS="you@example.com"
